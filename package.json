{
  "name": "@nbhson43/s-rich-editor",
  "version": "1.1.1",
  "description": "A lightweight, dependency-free rich text editor built with Vanilla JavaScript",
  "main": "dist/srich-editor.umd.js",
  "module": "dist/srich-editor.esm.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/srich-editor.esm.js",
      "require": "./dist/srich-editor.umd.js",
      "types": "./dist/types/index.d.ts"
    },
    "./dist/styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "test:unit": "npx vitest run",
    "test:e2e": "npx playwright test",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build",
    "demo": "open demo/index.html"
  },
  "keywords": [
    "rich-text-editor",
    "editor",
    "wysiwyg",
    "contenteditable",
    "vanilla-js",
    "lightweight",
    "dependency-free"
  ],
  "author": "Son Nguyen (https://github.com/nbhson)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbhson/srich-editor.git"
  },
  "homepage": "https://github.com/nbhson/srich-editor#readme",
  "bugs": {
    "url": "https://github.com/nbhson/srich-editor/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "rollup": "^4.9.0",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "^2.9.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "docx": "^9.7.1",
    "html2pdf.js": "^0.14.0"
  },
  "peerDependenciesMeta": {
    "docx": {
      "optional": true
    },
    "html2pdf.js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
